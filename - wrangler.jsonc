{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "south-york-roleplay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

,
"previews": {
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syrp-community-test",
      "database_id": "e1286ba2-80c1-4a39-a551-f95102329983"
    }
  ]
}

}
