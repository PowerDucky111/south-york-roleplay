{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "south-york-roleplay",
	"preview_urls": true,
	"compatibility_date": "2026-11-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "south-york-roleplay"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "syrp-community",
			"database_id": "1b1a7fff-8c7a-4144-91ca-6b3fdd1518db"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
    		"invocation_logs": true,
    		"persist": true
		},
		"traces": {
			"enabled": true,
    		"head_sampling_rate": 1,
    		"persist": true
  		}
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"previews": {
  		"vars": {
    		"DISCORD_REDIRECT_URL": "https://feature-discord-callsign-management-south-york-roleplay.sorleych4.workers.dev/api/auth/callback"
  		},
  		"d1_databases": [
		{
      		"binding": "DB",
      		"database_name": "syrp-community-test",
      		"database_id": "e1286ba2-80c1-4a39-a551-f95102329983"
    	}
  	],
  	"images": {
    	"binding": "IMAGES"
  	}
}

}